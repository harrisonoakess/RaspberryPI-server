# Copy to /etc/piuploader/config.env on the Pi (chown root:piuploader, chmod 640).
# The real file is never committed to git. Both services read this one file.

# --- Server contract ---------------------------------------------------------

# Public Railway domain for the server, no trailing /ping or /upload.
SERVER_URL=https://your-service.up.railway.app

# Shared bearer token. Must match the server's API_KEY Railway variable.
API_KEY=replace-me

# --- Pi networking -----------------------------------------------------------

# Built-in WiFi adapter on a Pi 3 Model B+.
WIFI_INTERFACE=wlan0

# How often the uploader checks WiFi and attempts queued uploads.
POLL_INTERVAL_SECONDS=30

# How often the POST /ping heartbeat is sent. Upload work does not wait for it.
PING_INTERVAL_SECONDS=300

REQUEST_TIMEOUT_SECONDS=10
# Uploads get their own, longer timeout: 10 MiB over Pi 3B+ WiFi.
UPLOAD_TIMEOUT_SECONDS=120
ERROR_LOG_REPEAT_SECONDS=300

# --- SD card ------------------------------------------------------------------
# setup.sh detects the card and appends CARD_UUID and CARD_FILESYSTEM below.
# Do not edit them by hand if the card is replaced; re-run setup.sh instead.

# Filesystem UUID of the one accepted card. Required — the watcher refuses to
# start without it and never falls back to an arbitrary removable drive.
# CARD_UUID=
# Filesystem type detected at setup time (used by the udev mount rule).
# CARD_FILESYSTEM=

# Read-only mountpoint provisioned by setup.sh's udev rule.
CARD_MOUNTPOINT=/mnt/sdcard

# How often the watcher re-checks for the card. The pyudev event fast path
# usually beats this; it is the fallback interval.
CARD_SCAN_INTERVAL_SECONDS=5

# --- Queue, ledger, and limits ------------------------------------------------

QUEUE_PATH=/var/lib/piuploader/queue
STATE_DB_PATH=/var/lib/piuploader/state.db

# Per-file ceiling, enforced on the Pi and on the server. 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Optional overrides for the rotating log files. Defaults shown; the systemd
# units only grant write access to /var/log/piuploader.
# LOG_PATH=/var/log/piuploader/uploader.log
# WATCHER_LOG_PATH=/var/log/piuploader/sdcard-watcher.log
# LOG_MAX_BYTES=1048576
# LOG_BACKUP_COUNT=5
