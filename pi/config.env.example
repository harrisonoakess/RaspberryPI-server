# Copy to /etc/piuploader/config.env on the Pi (chown piuploader:piuploader, chmod 640).
# The real file is never committed to git.

# Public Railway domain for the server, no trailing /ping.
SERVER_URL=https://your-service.up.railway.app

# Shared bearer token. Must match the server's API_KEY Railway variable.
API_KEY=replace-me

# Built-in WiFi adapter on a Pi 3 Model B+.
WIFI_INTERFACE=wlan0

POLL_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=10
ERROR_LOG_REPEAT_SECONDS=300

# Optional overrides for the rotating log file. Defaults shown; the systemd
# unit only grants write access to /var/log/piuploader.
# LOG_PATH=/var/log/piuploader/connectivity.log
# LOG_MAX_BYTES=1048576
# LOG_BACKUP_COUNT=5
