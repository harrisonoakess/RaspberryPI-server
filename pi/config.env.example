# Copy to /etc/piuploader/config.env on the Pi (chown root:piuploader, chmod 640).
# The real file is never committed to git. Both services read this one file.

# --- Server contract ---------------------------------------------------------

# Public Railway domain for the server, no trailing /ping or /upload.
SERVER_URL=https://your-service.up.railway.app

# Shared bearer token. Must match the server's API_KEY Railway variable.
API_KEY=replace-me

# --- Pi networking -----------------------------------------------------------

# Built-in WiFi adapter on a Pi 3 Model B+.
WIFI_INTERFACE=wlan0

# How often the uploader checks WiFi and attempts queued uploads.
POLL_INTERVAL_SECONDS=30

# How often the POST /ping heartbeat is sent. Upload work does not wait for it.
PING_INTERVAL_SECONDS=300

REQUEST_TIMEOUT_SECONDS=10
# Uploads get their own, longer timeout: 20 MiB over Pi 3B+ WiFi.
UPLOAD_TIMEOUT_SECONDS=120
ERROR_LOG_REPEAT_SECONDS=300

# --- SD card ------------------------------------------------------------------
# No card-specific setting exists in Phase 3. Any qualifying card is detected,
# mounted, and ingested automatically, and its identity is the filesystem UUID
# read live from whatever is mounted. Phase 2's CARD_UUID and CARD_FILESYSTEM
# are ignored if still present and can be deleted.

# Read-only mountpoint provisioned by sdcard-mounter.service.
CARD_MOUNTPOINT=/mnt/sdcard

# Subdirectory of the card holding the CSVs. Leave unset or empty to scan the
# card root. Garmin avionics cards keep flight logs under `data_log/`. The scan
# is one level deep, so give the full relative path if the logs sit deeper.
CARD_SCAN_SUBDIR=data_log

# How often the mounter reconciles block-device state against the mountpoint.
CARD_MOUNT_INTERVAL_SECONDS=2

# How often the watcher re-checks the mountpoint. The pyudev event fast path
# usually beats this; it is the fallback interval.
CARD_SCAN_INTERVAL_SECONDS=5

# --- Queue, ledger, and limits ------------------------------------------------

QUEUE_PATH=/var/lib/piuploader/queue
STATE_DB_PATH=/var/lib/piuploader/state.db

# Per-file ceiling, enforced on the Pi and on the server. 20 MiB.
MAX_UPLOAD_BYTES=20971520

# Optional overrides for the rotating log files. Defaults shown; the systemd
# units only grant write access to /var/log/piuploader.
# LOG_PATH=/var/log/piuploader/uploader.log
# WATCHER_LOG_PATH=/var/log/piuploader/sdcard-watcher.log
# MOUNTER_LOG_PATH=/var/log/piuploader/sdcard-mounter.log
# LOG_MAX_BYTES=1048576
# LOG_BACKUP_COUNT=5
