[Unit]
Description=Phase 2 Pi -> Railway uploader (heartbeat + queued CSV upload)
# Wants/After are ordering hints only: the daemon is designed to start and keep
# running while WiFi is unavailable.
Wants=network.target
After=network.target

# Keep a bad config from hot-looping; failures stay visible in the journal.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=piuploader
Group=piuploader
EnvironmentFile=/etc/piuploader/config.env
ExecStart=/usr/bin/python3 -u /opt/piuploader/uploader.py
Restart=on-failure
RestartSec=10
# An in-flight 20 MiB upload gets a moment to finish before SIGKILL.
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# The queue and ledger are shared with sdcard-watcher.service.
ReadWritePaths=/var/log/piuploader /var/lib/piuploader
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
