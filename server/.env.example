# Local FastAPI development configuration. Copy to `server/.env` and fill in.
# `server/.env` is gitignored and is loaded only by the local development
# command; Railway's production values are set in the Railway dashboard or CLI
# and never live in this repository.
#
#   cp server/.env.example server/.env
#
# None of these are Vite variables. They must never be given a VITE_ prefix and
# must never appear in frontend/.env, or they would be compiled into assets that
# any browser can read.

# Bearer token the Pi presents to POST /ping and POST /upload.
API_KEY=local-ingest-key-change-me

# Password for the dashboard login form. Choose your own; it must NOT equal
# API_KEY — the server refuses to start if they match, so the ingest credential
# can never sign in to the dashboard.
DASHBOARD_PASSWORD=local-dashboard-password-change-me

# Key that signs the dashboard session cookie. At least 32 UTF-8 bytes, and
# generated randomly rather than chosen by hand — nobody ever types this, so
# there is no reason for it to be memorable. Generate one with:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# A long human-chosen phrase is not equivalent entropy. Rotating this value
# invalidates every existing session.
DASHBOARD_SESSION_SECRET=replace-me-with-a-generated-48-byte-random-value

# Where the database and upload blobs live locally. On Railway these default to
# the mounted volume via RAILWAY_VOLUME_MOUNT_PATH and are not set by hand.
DATABASE_PATH=data/pings.db
UPLOADS_PATH=data/uploads

# Optional: compiled dashboard assets. Unset, the server looks in server/static,
# which is where the Docker build places them. Local development normally uses
# the Vite dev server instead, so this stays unset.
# DASHBOARD_DIST_PATH=../frontend/dist
